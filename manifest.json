{
  "name": "AstroGuard",
  "description": "Detect Reddit bots and astroturfing with tiered heuristic and AI analysis",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": [
    "*://*.reddit.com/*",
    "https://oauth.reddit.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["logo.png", "insights.html", "insights.css", "insights.js"],
      "matches": ["*://*.reddit.com/*"]
    }
  ]
}
